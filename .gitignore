.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
.claude/settings.local.json

# ---- D1 の中身 ----
# wrangler d1 export で書き出したものには、しおりの暗号文と札のハッシュが入る。マイグレーションだけを入れる
*.sql
!/migrations/*.sql
*.sqlite
*.sqlite3
*.sqlite-*

# ---- Node / Cloudflare Workers ----
node_modules/
.wrangler/
.svelte-kit/
build/
dist/
coverage/

# ---- テスト ----
test-results/
playwright-report/
blob-report/

# ---- ログ・キャッシュ ----
*.log
.eslintcache

# ---- 個人の作業用ファイル ----
.claude/users/

# ---- Vite ----
vite.config.ts.timestamp-*

# ---- Cloudflare Workers ----
