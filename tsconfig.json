{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// コードは全部 TypeScript で書く。JS まで確かめると、ビルドした後に
		// wrangler types が引き込む .svelte-kit/cloudflare/_worker.js でエラーになる
		"checkJs": false,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"]
	},
	"include": ["e2e", "src", "vite.config.ts", "playwright.config.ts"]
}
