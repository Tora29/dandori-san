{
	// 厳しさの設定は、Service Worker の tsconfig からも読めるように分けてある
	"extends": ["$app/tsconfig", "./tsconfig.strict.json"],
	"compilerOptions": {
		// コードは全部 TypeScript で書く。JS まで確かめると、ビルドした後に
		// wrangler types が引き込む .svelte-kit/cloudflare/_worker.js でエラーになる
		"checkJs": false,
		"types": [
			"$app/types",
			"node",
			"./worker-configuration.d.ts",
			"@cloudflare/vitest-plugin/types"
		]
	},
	"include": ["e2e", "src", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
	"exclude": ["src/service-worker"]
}
